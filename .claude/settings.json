{
  "permissions": {
    "defaultMode": "default",
    "allow": [
      "Bash(python manage.py test *)",
      "Bash(py313/bin/python manage.py test *)",
      "Bash(ruff check *)",
      "Bash(py313/bin/ruff check *)",
      "Bash(npm test *)",
      "Bash(npm run build *)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(gh issue list*)",
      "Bash(gh issue view*)",
      "Bash(gh pr view*)"
    ],
    "ask": [
      "Bash(git push*)",
      "Bash(gh pr create*)",
      "Bash(gh pr merge*)"
    ],
    "deny": [
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git push * --force*)",
      "Bash(git push * -f*)",
      "Read(./.env)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/ruff-fix.sh"
          }
        ]
      }
    ],
    "Notification": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "osascript -e 'display notification \"Claude 在等你回覆\" with title \"HearWell\" sound name \"Glass\"'"
          }
        ]
      }
    ]
  }
}