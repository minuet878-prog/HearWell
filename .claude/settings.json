{
  "permissions": {
    "defaultMode": "default",
    "allow": [
      "Bash(python manage.py test *)",
      "Bash(py313/bin/python manage.py test *)",
      "Bash(ruff check *)",
      "Bash(py313/bin/ruff check *)",
      "Bash(npm test *)",
      "Bash(npm run build *)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(gh issue list*)",
      "Bash(gh issue view*)",
      "Bash(gh pr view*)",
      "Bash(py313/bin/python -m ruff check *)",
      "Bash(ruff format --check *)",
      "Bash(py313/bin/ruff format --check *)",
      "Bash(git fetch *)",
      "Bash(git check-ignore *)",
      "Bash(git config user.name)",
      "Bash(git config user.email)",
      "mcp__claude-in-chrome__tabs_context_mcp",
      "mcp__claude-in-chrome__find",
      "mcp__Claude_Browser__read_page"
    ],
    "ask": [
      "Bash(git push*)",
      "Bash(gh pr create*)",
      "Bash(gh pr merge*)",
      "Bash(python manage.py migrate*)",
      "Bash(py313/bin/python manage.py migrate*)",
      "Bash(python manage.py shell*)",
      "Bash(py313/bin/python manage.py shell*)"
    ],
    "deny": [
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git push * --force*)",
      "Bash(git push * -f*)",
      "Read(./.env)",
      "Bash(python manage.py runserver*)",
      "Bash(py313/bin/python manage.py runserver*)",
      "Bash(python manage.py flush*)",
      "Bash(py313/bin/python manage.py flush*)",
      "Bash(python manage.py loaddata*)",
      "Bash(py313/bin/python manage.py loaddata*)",
      "Bash(python manage.py dbshell*)",
      "Bash(py313/bin/python manage.py dbshell*)",
      "Bash(docker *)",
      "Bash(brew services *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/main-commit-ask.py"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/ruff-fix.sh"
          }
        ]
      }
    ],
    "Notification": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "osascript -e 'display notification \"Claude 在等你回覆\" with title \"HearWell\" sound name \"Glass\"'"
          }
        ]
      }
    ]
  }
}
